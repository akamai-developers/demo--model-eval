# Run make setup to create a private .env, then enter your key there.
# Git ignores .env. The key stays on the server.

# The inference endpoint. Include the /v1 suffix.
AKAMAI_BASE_URL=https://api.akamai-inference.com/v1

# Leave the placeholder if you already export AKAMAI_INFERENCE_API_KEY.
AKAMAI_API_KEY=paste_your_key_here

# Port the app serves on. It binds to 127.0.0.1 only.
# PORT=8080
